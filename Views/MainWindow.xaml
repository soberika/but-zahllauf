<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="viafintech Zahllauf Dashboard"
    Height="840" Width="1320"
    WindowStartupLocation="CenterScreen"
    Background="#1E1E2E"
    FontFamily="Segoe UI"
    FontSize="13"
    Foreground="#E0E0E0">

    <Window.Resources>
        <!-- ===================== FARBEN ===================== -->
        <SolidColorBrush x:Key="BgPrimary"     Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgSecondary"   Color="#27293D"/>
        <SolidColorBrush x:Key="BgTertiary"    Color="#2E314A"/>
        <SolidColorBrush x:Key="BgCard"        Color="#252839"/>
        <SolidColorBrush x:Key="Accent"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentLight"   Color="#A78BFA"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#9CA3AF"/>
        <SolidColorBrush x:Key="Success"       Color="#10B981"/>
        <SolidColorBrush x:Key="Warning"       Color="#F59E0B"/>
        <SolidColorBrush x:Key="Danger"        Color="#EF4444"/>
        <SolidColorBrush x:Key="Border"        Color="#3A3D5C"/>

        <!-- ===================== TYPOGRAPHY ===================== -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ===================== BUTTONS ===================== -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3D5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4D7C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===================== SIDEBAR-BUTTON ===================== -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E314A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideBtnActive" TargetType="Button" BasedOn="{StaticResource SideBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CARD ===================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===================== TEXTBOX / CHECKBOX ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- ===================== HINWEIS-EXPANDER (Galerie) ===================== -->
        <Style x:Key="HintExpander" TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontWeight="SemiBold" FontSize="14"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===================== HAUPT-LAYOUT ===================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>      <!-- Top-Bar -->
            <RowDefinition Height="*"/>       <!-- Body     -->
            <RowDefinition Height="220"/>     <!-- Log      -->
        </Grid.RowDefinitions>

        <!-- ============ TOP-BAR ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="38" Height="38" CornerRadius="8"
                            Background="{StaticResource Accent}">
                        <TextBlock Text="V" FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Statische Texte werden beim Start aus Config\strings.de.json
                         ueberschrieben (Apply-Strings). Siehe doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBrandTitle" Text="viafintech Zahllauf"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="TxtBrandSubtitle" Text="Dashboard v1.0"
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopKW" Text="Kalenderwoche" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtKW" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopToday" Text="Heute" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtDate" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopSunday" Text="Letzter Sonntag" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtSunday" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="LblTopWeekSelect" Text="Bearbeitete KW" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="CmbWeek" Width="250" Height="30"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ BODY (Sidebar + Content + Right) ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- =========== Sidebar =========== -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <!-- Button-/Label-Texte werden aus Config\strings.de.json gesetzt
                     (Apply-Strings). Siehe doc\TEXTE_BEARBEITEN.md -->
                <StackPanel>
                    <TextBlock x:Name="LblSidebarSection" Text="ABLAUF"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="Bold"
                               Margin="22,22,0,10"/>
                    <Button x:Name="BtnStep1" Style="{StaticResource SideBtnActive}"
                            Content="1.  Mail"/>
                    <Button x:Name="BtnStep2" Style="{StaticResource SideBtn}"
                            Content="2.  Rechnungen"/>
                    <Button x:Name="BtnStep3" Style="{StaticResource SideBtn}"
                            Content="3.  Prüflauf"/>
                    <Button x:Name="BtnStep4" Style="{StaticResource SideBtn}"
                            Content="4.  Auszahlungslauf"/>
                    <Button x:Name="BtnStep5" Style="{StaticResource SideBtn}"
                            Content="5.  Abschluss"/>

                    <Border Height="1" Background="{StaticResource Border}"
                            Margin="20,18,20,10"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource SideBtn}"
                            Content="Einstellungen"/>
                </StackPanel>
            </Border>

            <!-- =========== Main Content =========== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Padding="30,24,30,24">
                <Grid>
                    <!-- ============ SCHRITT 1 - MAIL ============ -->
                    <!-- Statische Texte (Titel, Anleitung, Buttons) kommen aus
                         Config\strings.de.json (Apply-Strings). doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep1" Visibility="Visible">
                        <TextBlock x:Name="Txt1Title" Text="Schritt 1 - Mail" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt1Desc" Text="Wochenmail von viafintech prüfen und .msg-Dateien im _Temp-Ordner ablegen."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt1AnleitungTitle" Text="Anleitung" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt1Anleitung1" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="1. Outlook öffnen und die Wochenmail mit den Rechnungen suchen."/>
                                <TextBlock x:Name="Txt1Anleitung2" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="2. Alle relevanten .msg-Dateien in den _Temp-Ordner ziehen."/>
                                <TextBlock x:Name="Txt1Anleitung3" TextWrapping="Wrap" Margin="0,0,0,16"
                                           Text="3. Unten &quot;Pfad öffnen&quot; klicken, um den Ordner zu prüfen."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Btn1OpenPath"  Style="{StaticResource BtnBase}"
                                            Content="Pfad öffnen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn1Done"      Style="{StaticResource BtnSuccess}"
                                            Content="Schritt als erledigt markieren"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp1Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp1Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 2 - RECHNUNGEN ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleiben Txt2Preview/Txt2LastRun. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep2" Visibility="Collapsed">
                        <TextBlock x:Name="Txt2Title" Text="Schritt 2 - Rechnungen extrahieren" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt2Desc" Text="Verarbeitet die .msg-Dateien und erstellt die Excel-Sammeldatei (alleRechnungen.xlsx)."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt2OptionenTitle" Text="Optionen" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="Chk2NurExcel"
                                          Content="Nur Excel erstellen (CSV-Dateien liegen bereits vor)"/>

                                <TextBlock x:Name="Txt2PreviewTitle" Text="Vorschau Excel-Bezeichnung" Style="{StaticResource H2}" Margin="0,16,0,4"/>
                                <TextBox x:Name="Txt2Preview" IsReadOnly="True" Text="--"/>

                                <TextBlock x:Name="Txt2LastRunTitle" Text="Letzter Lauf" Style="{StaticResource H2}" Margin="0,16,0,4"/>
                                <TextBlock x:Name="Txt2LastRun" Style="{StaticResource Muted}" Text="noch nicht ausgeführt"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn2Run"      Style="{StaticResource BtnPrimary}"
                                            Content="Rechnungen extrahieren" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn2OpenPath" Style="{StaticResource BtnBase}"
                                            Content="Ergebnis-Ordner öffnen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp2Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp2Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 3 - PRUFLAUF ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleiben Txt3Bezeichnung/Txt3Checklist. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep3" Visibility="Collapsed">
                        <TextBlock x:Name="Txt3Title" Text="Schritt 3 - Prüflauf in Prosos" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt3Desc" Text="Bezeichnung und Fälligkeit für den Prüflauf festlegen."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt3BezeichnungTitle" Text="Bezeichnung" Style="{StaticResource H2}"/>
                                <TextBox x:Name="Txt3Bezeichnung" Text="--"/>

                                <TextBlock x:Name="Txt3FaelligkeitTitle" Text="Fälligkeit (letzter Sonntag)" Style="{StaticResource H2}" Margin="0,14,0,4"/>
                                <DatePicker x:Name="Dp3Faelligkeit" Width="200" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn3Copy"   Style="{StaticResource BtnPrimary}"
                                            Content="Bezeichnung in Zwischenablage" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn3Prosos" Style="{StaticResource BtnBase}"
                                            Content="Prosos öffnen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock x:Name="Txt3ChecklistTitle" Text="Checkliste" Style="{StaticResource H2}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="Txt3Checklist" Style="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="0/4 erledigt"/>
                                </Grid>
                                <CheckBox x:Name="Chk3Done0" Content="Prüflauf in Prosos angelegt"/>
                                <CheckBox x:Name="Chk3Done1" Content="Bezeichnung gesetzt"/>
                                <CheckBox x:Name="Chk3Done2" Content="Fälligkeit auf letzten Sonntag gestellt"/>
                                <CheckBox x:Name="Chk3Done3" Content="Prüflauf erfolgreich abgeschlossen"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp3Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp3Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 4 - AUSZAHLUNG ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleiben Txt4TaskStatus/Txt4Ordner/Txt4Status. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep4" Visibility="Collapsed">
                        <TextBlock x:Name="Txt4Title" Text="Schritt 4 - Auszahlungslauf" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt4Desc" Text="Baut den Task-Ordner und verschiebt die Dateien in den Zahllauf-Ordner."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <!-- Aufgabenplanung: Windows-Tasks on demand starten -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt4AufgabenTitle" Text="Aufgabenplanung" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt4AufgabenDesc" Text="Startet einen registrierten Windows-Task und meldet den Ausführungsstatus."
                                           Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <StackPanel x:Name="Sp4Tasks" Orientation="Horizontal" Margin="0,0,0,10"/>
                                <TextBlock x:Name="Txt4TaskStatus" Style="{StaticResource Muted}" Text="nicht gestartet"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt4OrdnerTitle" Text="Vorschau Ordnername" Style="{StaticResource H2}"/>
                                <TextBox x:Name="Txt4Ordner" IsReadOnly="True" Text="--"/>

                                <TextBlock x:Name="Txt4StatusTitle" Text="Task-Ordner Status" Style="{StaticResource H2}" Margin="0,14,0,4"/>
                                <TextBlock x:Name="Txt4Status" Style="{StaticResource Muted}" Text="nicht geprüft"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn4Run"        Style="{StaticResource BtnPrimary}"
                                            Content="Auszahlungslauf starten" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn4OpenTask"   Style="{StaticResource BtnBase}"
                                            Content="Task-Ordner öffnen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp4Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp4Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 5 - ABSCHLUSS ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep5" Visibility="Collapsed">
                        <TextBlock x:Name="Txt5Title" Text="Schritt 5 - Abschluss" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt5Desc" Text="Mail an Buchhaltung versenden und Lauf abschließen."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt5LetzteTitle" Text="Letzte Schritte" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="Chk5Done0" Content="Zahlungsdatei in Zahllauf-Ordner kopiert"/>
                                <CheckBox x:Name="Chk5Done1" Content="Bestätigung von Buchhaltung erhalten"/>
                                <CheckBox x:Name="Chk5Done2" Content="Backup gesichert"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn5MailTemplate" Style="{StaticResource BtnBase}"
                                            Content="Mail-Vorlage öffnen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn5Finish"       Style="{StaticResource BtnSuccess}"
                                            Content="Alles abschließen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp5Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp5Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SETTINGS ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleibt TxtSetStatus. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <TextBlock x:Name="TxtSetTitle" Text="Einstellungen - Pfade" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="TxtSetDesc" Text="Zentrale Ordner fuer Msg-Eingang, Task-Bearbeitung und Zahllauf-Ziel."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetMsgTitle" Text="Msg-Ordner (.msg-Dateien)" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetMsg" Grid.Column="0"/>
                                    <Button x:Name="BtnSetMsgBrowse" Grid.Column="1"
                                            Style="{StaticResource BtnBase}"
                                            Content="Ordner auswählen" Margin="10,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="TxtSetTaskTitle" Text="Task-Ordner (alleRechnungen.xlsx + Task-Skript-Arbeitsbereich)"
                                           Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetTask" Grid.Column="0"/>
                                    <Button x:Name="BtnSetTaskBrowse" Grid.Column="1"
                                            Style="{StaticResource BtnBase}"
                                            Content="Ordner auswählen" Margin="10,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="TxtSetZahllaufTitle" Text="Zahllauf-Ordner (Zielordner)" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetZahllauf" Grid.Column="0"/>
                                    <Button x:Name="BtnSetZahllaufBrowse" Grid.Column="1"
                                            Style="{StaticResource BtnBase}"
                                            Content="Ordner auswählen" Margin="10,0,0,0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnSetSave" Style="{StaticResource BtnPrimary}"
                                            Content="Einstellungen speichern" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtSetStatus" VerticalAlignment="Center"
                                               Style="{StaticResource Muted}" Text=""/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetBehaviorTitle" Text="Abschluss-Optionen" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="ChkSetSimulate"
                                          Content="Cleanup simulieren (kein echtes Löschen)"/>
                                <TextBlock x:Name="TxtSetSimulateDesc" Text="Wenn aktiv: .msg-Dateien und Anhänge werden nur im Log aufgelistet, nicht gelöscht."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Margin="22,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- =========== Right Panel =========== -->
            <Border Grid.Column="2" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
                <!-- Label-Texte aus Config\strings.de.json (Apply-Strings); die
                     Werte (Txt*Right) bleiben dynamisch. doc\TEXTE_BEARBEITEN.md -->
                <StackPanel Margin="18,22,18,18">
                    <TextBlock x:Name="LblRightSection" Text="STATUS"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="Bold" Margin="0,0,0,14"/>

                    <TextBlock x:Name="TxtStatusKW" Text="--"
                               Style="{StaticResource Muted}" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="LblRightProgress" Text="Fortschritt" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtStatusProgress" Text="--" FontSize="16" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="TxtStatus0" Text="--" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtStatus1" Text="--" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtStatus2" Text="--" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtStatus3" Text="--" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ LOG-AREA ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="20,12,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="LblLogSection" Text="LOG" Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnOpenLog" Content="Log-Datei öffnen"
                                Style="{StaticResource BtnBase}"
                                Padding="10,4" FontSize="11" Margin="0,0,8,0"/>
                        <Button x:Name="BtnClearLog" Content="Log löschen"
                                Style="{StaticResource BtnBase}"
                                Padding="10,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#13131F"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="6">
                    <RichTextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="#E0E0E0"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 Padding="10"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
