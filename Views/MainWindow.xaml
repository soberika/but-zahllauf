<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="viafintech Zahllauf Dashboard"
    Height="840" Width="1320"
    WindowStartupLocation="CenterScreen"
    Background="#1E1E2E"
    FontFamily="Segoe UI"
    FontSize="13"
    Foreground="#E0E0E0">

    <Window.Resources>
        <!-- ===================== FARBEN ===================== -->
        <SolidColorBrush x:Key="BgPrimary"     Color="#1E1E2E"/>
        <SolidColorBrush x:Key="BgSecondary"   Color="#27293D"/>
        <SolidColorBrush x:Key="BgTertiary"    Color="#2E314A"/>
        <SolidColorBrush x:Key="BgCard"        Color="#252839"/>
        <SolidColorBrush x:Key="Accent"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentLight"   Color="#A78BFA"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#9CA3AF"/>
        <SolidColorBrush x:Key="Success"       Color="#10B981"/>
        <SolidColorBrush x:Key="Warning"       Color="#F59E0B"/>
        <SolidColorBrush x:Key="Danger"        Color="#EF4444"/>
        <SolidColorBrush x:Key="Border"        Color="#3A3D5C"/>

        <!-- ===================== TYPOGRAPHY ===================== -->
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ===================== BUTTONS ===================== -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3D5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4A4D7C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#2A2A3A"/>
                                <Setter Property="Foreground" Value="#5A5D70"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#8B5CF6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Success}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===================== SIDEBAR-BUTTON ===================== -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E314A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideBtnActive" TargetType="Button" BasedOn="{StaticResource SideBtn}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== CARD ===================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ===================== TEXTBOX / CHECKBOX ===================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Background" Value="{StaticResource BgTertiary}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <!-- ===================== HINWEIS-EXPANDER (Galerie) ===================== -->
        <Style x:Key="HintExpander" TargetType="Expander">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontWeight="SemiBold" FontSize="14"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===================== HAUPT-LAYOUT ===================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>      <!-- Top-Bar -->
            <RowDefinition Height="*"/>       <!-- Body     -->
            <RowDefinition Height="220"/>     <!-- Log      -->
        </Grid.RowDefinitions>

        <!-- ============ TOP-BAR ============ -->
        <Border Grid.Row="0" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="38" Height="38" CornerRadius="8"
                            Background="{StaticResource Accent}">
                        <TextBlock Text="V" FontSize="22" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- Statische Texte werden beim Start aus Config\strings.de.json
                         ueberschrieben (Apply-Strings). Siehe doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBrandTitle" Text="viafintech Zahllauf"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="TxtBrandSubtitle" Text="Dashboard v1.0"
                                   Style="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopKW" Text="Kalenderwoche" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtKW" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopToday" Text="Heute" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtDate" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopSunday" Text="Letzter Sonntag" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtSunday" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="6,8" Padding="14,8">
                        <StackPanel>
                            <TextBlock x:Name="LblTopYear" Text="Jahr" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="TxtYear" Text="--"
                                       FontSize="18" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock x:Name="LblTopWeekSelect" Text="Bearbeitete KW" Style="{StaticResource Muted}"/>
                    <ComboBox x:Name="CmbWeek" Width="250" Height="30"
                              VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ BODY (Sidebar + Content) ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =========== Sidebar =========== -->
            <Border Grid.Column="0" Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <!-- Button-/Label-Texte werden aus Config\strings.de.json gesetzt
                     (Apply-Strings). Siehe doc\TEXTE_BEARBEITEN.md -->
                <StackPanel>
                    <TextBlock x:Name="LblSidebarSection" Text="ABLAUF"
                               Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="Bold"
                               Margin="22,22,0,10"/>
                    <Button x:Name="BtnStep1" Style="{StaticResource SideBtnActive}"
                            Content="1.  Mail"/>
                    <Button x:Name="BtnStep2" Style="{StaticResource SideBtn}"
                            Content="2.  Rechnungen"/>
                    <Button x:Name="BtnStep3" Style="{StaticResource SideBtn}"
                            Content="3.  Prüflauf"/>
                    <Button x:Name="BtnStep4" Style="{StaticResource SideBtn}"
                            Content="4.  Auszahlungslauf"/>
                    <Button x:Name="BtnStep5" Style="{StaticResource SideBtn}"
                            Content="5.  Abschluss"/>

                    <Border Height="1" Background="{StaticResource Border}"
                            Margin="20,18,20,10"/>
                    <Button x:Name="BtnSettings" Style="{StaticResource SideBtn}"
                            Content="Einstellungen"/>
                </StackPanel>
            </Border>

            <!-- =========== Main Content =========== -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          Padding="30,24,30,24">
                <Grid>
                    <!-- ============ SCHRITT 1 - MAIL ============ -->
                    <!-- Statische Texte (Titel, Anleitung, Buttons) kommen aus
                         Config\strings.de.json (Apply-Strings). doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep1" Visibility="Visible">
                        <TextBlock x:Name="Txt1Title" Text="1. Rechnungen aus wöchtl. Mail abspeichern" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt1Desc" Text="Wochenmail von viafintech prüfen und .msg-Dateien im _Temp-Ordner ablegen."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <!-- Karte A: Outlook oeffnen -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt1OutlookTitle" Text="Outlook öffnen" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt1OutlookDesc" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="Outlook öffnen und die wöchentliche viafintech-Mail mit den Rechnungen heraussuchen. Über den Button startet Outlook direkt."/>
                                <Button x:Name="Btn1OpenOutlook" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                        Content="Outlook öffnen"/>
                            </StackPanel>
                        </Border>

                        <!-- Karte B: Mail im temporaeren Ordner abspeichern -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt1SaveTitle" Text="Mail im temporären Ordner abspeichern" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt1SaveDesc" TextWrapping="Wrap" Margin="0,0,0,12"
                                           Text="Die Mails an die jeweils passende Stelle ablegen - per Maus hineinziehen oder in Outlook über &quot;Alle Anlagen speichern&quot;."/>

                                <!-- 1. Haushalt-Mail in den Task-Ordner -->
                                <CheckBox x:Name="Chk1Task" Content="Mail vom Haushalt in &quot;Task&quot;-Ordner ziehen"/>
                                <Button x:Name="Btn1OpenTask" Style="{StaticResource BtnBase}" HorizontalAlignment="Left"
                                        Content="&quot;Task&quot;-Ordner öffnen" Margin="22,6,0,0"/>

                                <!-- 2. Rechnungsmails in den ViafintechMails-Ordner -->
                                <CheckBox x:Name="Chk1Mails" Content="Rechnungsmails in &quot;ViafintechMails&quot; ziehen" Margin="0,18,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                                    <Button x:Name="Btn1OpenPath"  Style="{StaticResource BtnBase}"
                                            Content="&quot;ViafintechMails&quot;-Ordner öffnen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn1CopyPath"  Style="{StaticResource BtnBase}"
                                            Content="Ordner Pfad in Zwischenablage"/>
                                </StackPanel>

                                <Button x:Name="Btn1Done" Style="{StaticResource BtnSuccess}" HorizontalAlignment="Left"
                                        Content="Schritt als erledigt markieren" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp1Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp1Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 2 - RECHNUNGEN ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleiben Txt2Preview/Txt2LastRun. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep2" Visibility="Collapsed">
                        <TextBlock x:Name="Txt2Title" Text="Schritt 2 - Rechnungen extrahieren" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt2Desc" Text="Verarbeitet die .msg-Dateien und erstellt die Excel-Sammeldatei (alleRechnungen.xlsx)."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <!-- Optionen (eigene Karte, oberhalb) -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt2OptionenTitle" Text="Optionen" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="Chk2NurExcel"
                                          Content="Nur Excel erstellen (CSV-Dateien liegen bereits vor)"/>
                            </StackPanel>
                        </Border>

                        <!-- Block 1: Zusammenfassung der Rechnungen -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt2SummaryTitle" Text="Zusammenfassung der Rechnungen" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt2SummaryDesc" TextWrapping="Wrap" Margin="0,0,0,14"
                                           Text="Die gespeicherten Anlagen werden per Skript in eine Excel-Tabelle (alleRechnungen.xlsx) extrahiert und zusammengefasst."/>

                                <TextBlock x:Name="Txt2PreviewTitle" Text="Vorschau der Excel-Bezeichnung" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                                <TextBox x:Name="Txt2Preview" IsReadOnly="True" Text="--"/>

                                <TextBlock x:Name="Txt2LastRunTitle" Text="Automatische Umwandlung und Zusammenfassung" Style="{StaticResource H2}" Margin="0,16,0,4"/>
                                <TextBlock x:Name="Txt2LastRun" Style="{StaticResource Muted}" Text="noch nicht ausgeführt"/>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="Btn2Run"       Style="{StaticResource BtnPrimary}"
                                            Content="Rechnungen extrahieren" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn2OpenExcel" Style="{StaticResource BtnBase}"
                                            Content="Excel öffnen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn2OpenPath"  Style="{StaticResource BtnBase}"
                                            Content="Ordner mit Extrahierten .pdf und .csv öffnen"/>
                                </StackPanel>

                                <TextBlock x:Name="Txt2MergeTitle" Text="Anhänge als PDF zusammenfassen" Style="{StaticResource H2}" Margin="0,18,0,4"/>
                                <TextBlock x:Name="Txt2MergeDesc" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Fasst die extrahierten Einzel-PDFs in Mail-Reihenfolge zu einer Sammeldatei (alleRechnungen_Anhaenge.pdf) im Task-Ordner zusammen."/>
                                <TextBlock x:Name="Txt2MergeStatus" Style="{StaticResource Muted}" Text="noch nicht ausgeführt"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="Btn2MergePdf"      Style="{StaticResource BtnPrimary}"
                                            Content="PDFs zusammenfassen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn2OpenMergedPdf" Style="{StaticResource BtnBase}"
                                            Content="Zusammengefasste PDF öffnen"/>
                                </StackPanel>

                                <Button x:Name="Btn2Done" Style="{StaticResource BtnSuccess}" HorizontalAlignment="Left"
                                        Content="Schritt als erledigt markieren" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp2Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp2Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 3 - PRUFLAUF ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleiben Txt3Bezeichnung/Txt3Summe. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep3" Visibility="Collapsed">
                        <TextBlock x:Name="Txt3Title" Text="Schritt 3 - Prüflauf in Prosos" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt3Desc" Text="Bezeichnung und Fälligkeit für den Prüflauf festlegen."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt3ProsozTitle" Text="OPEN/Prosoz öffnen" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt3ProsozDesc" Text="Prosoz öffnen und unter Zahlbarmachung &quot;Prüflauf erstellen&quot; auswählen."
                                           Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                <Button x:Name="Btn3Prosos" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Left"
                                        Content="OPEN/Prosoz öffnen" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt3BezeichnungTitle" Text="Bezeichnung" Style="{StaticResource H2}"/>
                                <TextBox x:Name="Txt3Bezeichnung" Text="--"/>

                                <TextBlock x:Name="Txt3FaelligkeitTitle" Text="Fälligkeit (letzter Sonntag)" Style="{StaticResource H2}" Margin="0,14,0,4"/>
                                <DatePicker x:Name="Dp3Faelligkeit" Width="200" HorizontalAlignment="Left"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn3Copy"   Style="{StaticResource BtnPrimary}"
                                            Content="Bezeichnung in Zwischenablage"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt3SummeTitle" Text="Gesamtsumme prüfen" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt3SummeDesc"
                                           Text="Aus der erstellten Gesamtliste der Rechnungen die Summe vergleichen mit den Haushaltsstellengesamtbeträgen. Ansonsten Buchungen abwählen."
                                           Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                    <Button x:Name="Btn3Summe" Style="{StaticResource BtnBase}"
                                            Content="Gesamtsumme ermitteln" Margin="0,0,14,0"/>
                                    <TextBlock x:Name="Txt3Summe" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                               Text=""/>
                                </StackPanel>
                                <Button x:Name="Btn3Done" Style="{StaticResource BtnSuccess}" HorizontalAlignment="Left"
                                        Content="Schritt als erledigt markieren" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp3Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp3Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 4 - AUSZAHLUNG ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleiben Txt4TaskStatus/Txt4Ordner/Txt4Status. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep4" Visibility="Collapsed">
                        <TextBlock x:Name="Txt4Title" Text="Schritt 4 - Auszahlungslauf" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt4Desc" Text="Baut den Task-Ordner und verschiebt die Dateien in den Zahllauf-Ordner."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <!-- Aufgabenplanung: Windows-Tasks on demand starten -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt4AufgabenTitle" Text="Aufgabenplanung" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt4AufgabenDesc" Text="Startet einen registrierten Windows-Task und meldet den Ausführungsstatus."
                                           Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <StackPanel x:Name="Sp4Tasks" Orientation="Horizontal" Margin="0,0,0,10"/>
                                <TextBlock x:Name="Txt4TaskStatus" Style="{StaticResource Muted}" Text="nicht gestartet"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt4ErstellungTitle" Text="Erstellung und Übergabe in den Zielordner" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt4OrdnerTitle" Text="Vorschau Ordnername" Style="{StaticResource Muted}" Margin="0,6,0,4"/>
                                <TextBox x:Name="Txt4Ordner" IsReadOnly="True" Text="--"/>

                                <TextBlock x:Name="Txt4StatusTitle" Text="Task-Ordner Status" Style="{StaticResource H2}" Margin="0,14,0,4"/>
                                <TextBlock x:Name="Txt4Status" Style="{StaticResource Muted}" Text="nicht geprüft"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn4Run"        Style="{StaticResource BtnPrimary}"
                                            Content="Verarbeitung der Zahllisten" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn4OpenTask"   Style="{StaticResource BtnBase}"
                                            Content="Task-Ordner öffnen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt4AbgleichTitle" Text="Abgleich der Gesamtsummen" Style="{StaticResource H2}"/>
                                <TextBlock x:Name="Txt4AbgleichDesc" Style="{StaticResource Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                                           Text="Nach dem Verschieben die beiden Zieldateien zur letzten Kontrolle öffnen."/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="Btn4OpenXlsx" Style="{StaticResource BtnBase}" IsEnabled="False"
                                            Content="alleRechnungen.xlsx öffnen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn4OpenPdf"  Style="{StaticResource BtnBase}" IsEnabled="False"
                                            Content="Haushaltsstellengesamtbeträge öffnen"/>
                                </StackPanel>
                                <Button x:Name="Btn4Done" Style="{StaticResource BtnSuccess}" HorizontalAlignment="Left"
                                        Content="Schritt als erledigt markieren" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp4Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp4Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SCHRITT 5 - ABSCHLUSS ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageStep5" Visibility="Collapsed">
                        <TextBlock x:Name="Txt5Title" Text="Schritt 5 - Abschluss" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="Txt5Desc" Text="Mail an Buchhaltung versenden und Lauf abschließen."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="Txt5LetzteTitle" Text="Letzte Schritte" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="Chk5Done0" Content="Zahlungsdatei in Zahllauf-Ordner kopiert"/>
                                <CheckBox x:Name="Chk5Done1" Content="Bestätigung von Buchhaltung erhalten"/>
                                <CheckBox x:Name="Chk5Done2" Content="Backup gesichert"/>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button x:Name="Btn5MailTemplate" Style="{StaticResource BtnBase}"
                                            Content="Mail-Vorlage öffnen" Margin="0,0,10,0"/>
                                    <Button x:Name="Btn5DeleteTemp"   Style="{StaticResource BtnBase}"
                                            Content="Temporäre Dateien löschen"/>
                                </StackPanel>

                                <TextBlock x:Name="Txt5FinishNote" Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Margin="0,18,0,8"
                                           Text="Damit ist die Übergabe veranlasst und das Log gesichert. Anschließend die Rückmeldung vom Haushalt abwarten."/>
                                <Button x:Name="Btn5Finish" Style="{StaticResource BtnSuccess}" HorizontalAlignment="Left"
                                        Content="Zahllauf abgeschlossen"/>
                            </StackPanel>
                        </Border>

                        <Expander x:Name="Exp5Hints" Style="{StaticResource HintExpander}" Header="Bebilderte Hinweise">
                            <WrapPanel x:Name="Sp5Hints" Margin="0,10,0,0"/>
                        </Expander>
                    </StackPanel>

                    <!-- ============ SETTINGS ============ -->
                    <!-- Statische Texte aus Config\strings.de.json (Apply-Strings).
                         Dynamisch bleibt TxtSetStatus. doc\TEXTE_BEARBEITEN.md -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <TextBlock x:Name="TxtSetTitle" Text="Einstellungen - Pfade" Style="{StaticResource H1}"/>
                        <TextBlock x:Name="TxtSetDesc" Text="Zentrale Ordner für Rechnungsmails (.msg), Umbenennung und Übergabe."
                                   Style="{StaticResource Muted}" Margin="0,0,0,18"/>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetMsgTitle" Text="Ordner für die einzelnen Viafintech-Rechnungsmails (.msg)" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetMsg" Grid.Column="0"/>
                                    <Button x:Name="BtnSetMsgBrowse" Grid.Column="1"
                                            Style="{StaticResource BtnBase}"
                                            Content="Ordner auswählen" Margin="10,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="TxtSetTaskTitle" Text="Task-Ordner (Sammelordner für die Umbenennung)"
                                           Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetTask" Grid.Column="0"/>
                                    <Button x:Name="BtnSetTaskBrowse" Grid.Column="1"
                                            Style="{StaticResource BtnBase}"
                                            Content="Ordner auswählen" Margin="10,0,0,0"/>
                                </Grid>

                                <TextBlock x:Name="TxtSetZahllaufTitle" Text="Zahllauf-Ordner (Zielpfad für Übergabe)" Style="{StaticResource H2}"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSetZahllauf" Grid.Column="0"/>
                                    <Button x:Name="BtnSetZahllaufBrowse" Grid.Column="1"
                                            Style="{StaticResource BtnBase}"
                                            Content="Ordner auswählen" Margin="10,0,0,0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BtnSetSave" Style="{StaticResource BtnPrimary}"
                                            Content="Einstellungen speichern" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="TxtSetStatus" VerticalAlignment="Center"
                                               Style="{StaticResource Muted}" Text=""/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock x:Name="TxtSetBehaviorTitle" Text="Abschluss-Optionen" Style="{StaticResource H2}"/>
                                <CheckBox x:Name="ChkSetSimulate"
                                          Content="Cleanup simulieren (kein echtes Löschen)"/>
                                <TextBlock x:Name="TxtSetSimulateDesc" Text="Wenn aktiv: .msg-Dateien und Anhänge werden nur im Log aufgelistet, nicht gelöscht."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Margin="22,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Right Panel "Globale Parameter" entfernt (2026-06-01): redundant zu
                 Top-Bar (KW/Jahr) und Schritt-Karten (Bezeichnung/Ordnername). -->
        </Grid>

        <!-- ============ LOG-AREA ============ -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="20,12,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock x:Name="LblLogSection" Text="LOG" Foreground="{StaticResource TextMuted}"
                               FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnOpenLog" Content="Log-Datei öffnen"
                                Style="{StaticResource BtnBase}"
                                Padding="10,4" FontSize="11" Margin="0,0,8,0"/>
                        <Button x:Name="BtnClearLog" Content="Log löschen"
                                Style="{StaticResource BtnBase}"
                                Padding="10,4" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#13131F"
                        BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="6">
                    <RichTextBox x:Name="LogBox"
                                 Background="Transparent"
                                 Foreground="#E0E0E0"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="12"
                                 Padding="10"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
